{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZoryaLMS Firestore ERD Schema",
  "description": "Collection and field catalog for every collection in firestore.indexes.json. LIS fields follow the current React forms. Legacy business collections are included so the catalog and the index file name the same collections. Lookup fields are string values; relationships are descriptive annotations and are not enforced by Firestore.",
  "type": "object",
  "$defs": {
    "sample": {
      "type": "object",
      "properties": {
        "sampleNo": { "type": "string" },
        "testRequestId": { "type": "string", "x-relationship": { "collection": "testRequest", "field": "id", "stores": "documentId" } },
        "patientId": { "type": "string", "x-relationship": { "collection": "patient", "field": "id", "stores": "documentId" } },
        "specimenId": { "type": "string", "x-relationship": { "collection": "specimen", "field": "id", "stores": "documentId" } },
        "barcode": { "type": "string" },
        "sampleCollectionDate": { "type": "string", "format": "date-time" },
        "collectedBy": { "type": "string" },
        "collectionStatus": { "type": "string", "enum": ["Pending", "Collected", "Rejected"] },
        "sampleReceivedDate": { "type": "string", "format": "date-time" },
        "receivedBy": { "type": "string" },
        "receivingStatus": { "type": "string", "enum": ["Pending", "Received", "Rejected"] },
        "rejectionReasonId": { "type": "string", "x-relationship": { "collection": "lookupMaster", "field": "id", "stores": "documentId" } },
        "status": { "type": "string", "enum": ["Pending", "Collected", "Received", "Rejected", "Processing", "Completed"] }
      },
      "required": ["sampleNo", "patientId"]
    },
    "testResult": {
      "type": "object",
      "properties": {
        "patientId": { "type": "string", "x-relationship": { "collection": "patient", "field": "id", "stores": "documentId" } },
        "testRequestId": { "type": "string", "x-relationship": { "collection": "testRequest", "field": "id", "stores": "documentId" } },
        "sampleNo": { "type": "string" },
        "hisTestCode": { "type": "string" },
        "lisTestCode": { "type": "string" },
        "specimenCode": { "type": "string" },
        "specimenName": { "type": "string" },
        "resultDate": { "type": "string", "format": "date-time" },
        "sampleCollectionDate": { "type": "string", "format": "date-time" },
        "sampleReceivedDate": { "type": "string", "format": "date-time" },
        "authorizationDate": { "type": "string", "format": "date-time" },
        "authorizedBy": { "type": "string" },
        "reviewDate": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string" },
        "technicianNote": { "type": "string" },
        "doctorNote": { "type": "string" },
        "equipmentId": { "type": "string", "x-relationship": { "collection": "equipment", "field": "id", "stores": "documentId" } }
      },
      "required": ["patientId", "testRequestId"]
    },
    "radiologyResult": {
      "type": "object",
      "properties": {
        "radiologyRequestId": { "type": "string", "x-relationship": { "collection": "radiologyRequest", "field": "id", "stores": "documentId" } },
        "findings": { "type": "string" },
        "impression": { "type": "string" },
        "reportDateTime": { "type": "string", "format": "date-time" },
        "reportedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Finalized", "Cancelled"] }
      },
      "required": ["radiologyRequestId"]
    },
    "controlResult": {
      "type": "object",
      "properties": {
        "controlNo": { "type": "string" },
        "testName": { "type": "string" },
        "controlLevel": { "type": "string", "enum": ["Level 1", "Level 2", "Level 3"] },
        "resultDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["In Control", "Out of Control"] }
      },
      "required": ["controlNo", "testName"]
    },
    "department": {
      "type": "object",
      "properties": {
        "departmentCode": { "type": "string" },
        "departmentName": { "type": "string" },
        "processingCategory": { "type": "string", "enum": ["Laboratory", "Radiology"] },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["departmentCode", "departmentName", "processingCategory"]
    },
    "unit": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["code", "name"]
    },
    "method": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["code", "name"]
    },
    "equipment": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "model": { "type": "string" },
        "accessKey": { "type": "string" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["name", "accessKey"]
    },
    "equipmentHeartbeat": {
      "type": "object",
      "properties": {
        "equipmentId": { "type": "string", "x-relationship": { "collection": "equipment", "field": "id", "stores": "documentId" } },
        "lastHeartBeatTime": { "type": "string", "format": "date-time" },
        "isOnline": { "type": "string", "enum": ["Yes", "No"] },
        "lastErrorMessage": { "type": "string" },
        "recordedOn": { "type": "string", "format": "date" }
      },
      "required": ["equipmentId", "lastHeartBeatTime"]
    },
    "reportTemplateConfiguration": {
      "type": "object",
      "properties": {
        "templateName": { "type": "string" },
        "templateType": { "type": "string" },
        "templateContent": { "type": "string" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["templateName"]
    },
    "hisTest": {
      "type": "object",
      "properties": {
        "hisTestCode": { "type": "string", "readOnly": true },
        "hisTestCodeDescription": { "type": "string" },
        "specimenId": { "type": "string", "x-relationship": { "collection": "specimen", "field": "id", "stores": "documentId" } },
        "departmentCode": { "type": "string", "x-relationship": { "collection": "department", "field": "departmentCode", "stores": "departmentCode" } },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["hisTestCode", "hisTestCodeDescription", "specimenId", "departmentCode"]
    },
    "testProfile": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "readOnly": true },
        "name": { "type": "string" },
        "packageRate": { "type": "number" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] },
        "profileTests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "testId": { "type": "string", "x-relationship": { "collection": "hisTest", "field": "id", "stores": "documentId" } },
              "quantity": { "type": "number" }
            }
          }
        }
      },
      "required": ["code", "name"]
    },
    "specimen": {
      "type": "object",
      "properties": {
        "specimenName": { "type": "string" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["specimenName"]
    },
    "testRate": {
      "type": "object",
      "properties": {
        "rate": { "type": "number" },
        "emergencyRate": { "type": "number" },
        "discount": { "type": "number" },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveTo": { "type": "string", "format": "date" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] },
        "testId": { "type": "string", "x-relationship": { "collection": "hisTest", "field": "id", "stores": "documentId" } },
        "rateType": { "type": "string", "enum": ["Standard", "Emergency", "Package"] }
      },
      "required": ["rate", "effectiveFrom", "effectiveTo", "testId"]
    },
    "referralDoctor": {
      "type": "object",
      "properties": {
        "doctorCode": { "type": "string" },
        "doctorName": { "type": "string" },
        "qualification": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string" },
        "type": { "type": "string", "enum": ["Corporate", "Self"] },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["doctorCode", "doctorName"]
    },
    "doctorCommissionRate": {
      "type": "object",
      "properties": {
        "referralDoctorId": { "type": "string", "x-relationship": { "collection": "referralDoctor", "field": "id", "stores": "documentId" } },
        "commissionPercent": { "type": "number" },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveTo": { "type": "string", "format": "date" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["referralDoctorId", "commissionPercent", "effectiveFrom"]
    },
    "sampleCollector": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["code", "name"]
    },
    "collectorCommissionRate": {
      "type": "object",
      "properties": {
        "collectorId": { "type": "string", "x-relationship": { "collection": "sampleCollector", "field": "id", "stores": "documentId" } },
        "commissionPercent": { "type": "number" },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveTo": { "type": "string", "format": "date" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["collectorId", "commissionPercent", "effectiveFrom"]
    },
    "corporate": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "defaultDiscountPercent": { "type": "number" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["code", "name"]
    },
    "hisParameter": {
      "type": "object",
      "properties": {
        "hisParamCode": { "type": "string" },
        "hisParamDescription": { "type": "string" },
        "unitId": { "type": "string", "x-relationship": { "collection": "unit", "field": "id", "stores": "documentId" } },
        "methodId": { "type": "string", "x-relationship": { "collection": "method", "field": "id", "stores": "documentId" } },
        "comment": { "type": "string", "description": "Rich text stored as HTML." },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["hisParamCode", "hisParamDescription"]
    },
    "testMapping": {
      "type": "object",
      "properties": {
        "lisParamCode": { "type": "string" },
        "lisParamDescription": { "type": "string" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] },
        "parameterId": { "type": "string", "x-relationship": { "collection": "hisParameter", "field": "id", "stores": "documentId" } },
        "equipmentId": { "type": "string", "x-relationship": { "collection": "equipment", "field": "id", "stores": "documentId" } }
      },
      "required": ["lisParamCode", "parameterId", "equipmentId"]
    },
    "testParameter": {
      "type": "object",
      "properties": {
        "sequence": { "type": "number" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] },
        "testId": { "type": "string", "x-relationship": { "collection": "hisTest", "field": "id", "stores": "documentId" } },
        "parameterId": { "type": "string", "x-relationship": { "collection": "hisParameter", "field": "id", "stores": "documentId" } }
      },
      "required": ["sequence", "testId", "parameterId"]
    },
    "parameterRange": {
      "type": "object",
      "properties": {
        "rangeCode": { "type": "string", "readOnly": true },
        "rangeValue": { "type": "string" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Both"] },
        "ageFrom": { "type": "number" },
        "ageTo": { "type": "number" },
        "ageType": { "type": "string", "enum": ["Year", "Month", "Day"] },
        "minValue": { "type": "number" },
        "maxValue": { "type": "number" },
        "parameter": { "type": "string", "x-relationship": { "collection": "testParameter", "field": "id", "stores": "documentId" } }
      },
      "required": ["gender", "parameter"]
    },
    "patient": {
      "type": "object",
      "properties": {
        "mrNo": { "type": "string", "readOnly": true },
        "visitId": { "type": "string", "readOnly": true },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "dateOfBirth": { "type": "string", "format": "date" },
        "patientNo": { "type": "string", "readOnly": true },
        "salutation": { "type": "string", "enum": ["Mr", "Mr.", "Miss", "Mrs.", "Ms."] },
        "gender": { "type": "string", "enum": ["M", "F"] },
        "age": { "type": "number" },
        "address": { "type": "string" },
        "active": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["name", "phoneNumber", "salutation", "gender"]
    },
    "saleInvoiceLine": {
      "type": "object",
      "properties": {
        "itemType": { "type": "string", "enum": ["test", "profile"] },
        "lineItemKey": { "type": "string" },
        "testId": { "type": "string", "x-relationship": { "collection": "hisTest", "field": "id", "stores": "documentId", "appliesWhen": "itemType=test" } },
        "testProfileId": { "type": ["string", "null"], "x-relationship": { "collection": "testProfile", "field": "id", "stores": "documentId", "appliesWhen": "itemType=profile" } },
        "testName": { "type": "string" },
        "departmentCode": { "type": "string", "description": "Copied from the HIS Test selection; not enforced as a reference." },
        "departmentName": { "type": "string", "description": "Display-name snapshot copied when the invoice line is added." },
        "rate": { "type": "number" },
        "quantity": { "type": "number" },
        "discountType": { "type": "string", "enum": ["Fixed Amount", "Percentage"] },
        "discountValue": { "type": "number" },
        "amount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "netAmount": { "type": "number" }
      }
    },
    "saleInvoice": {
      "type": "object",
      "properties": {
        "invoiceNo": { "type": "string" },
        "invoiceDate": { "type": "string", "format": "date" },
        "invoiceStatus": { "type": ["string", "number"], "description": "Generic form uses Draft/Finalized/Cancelled; custom Add page writes 0 Draft or 1 Confirmed." },
        "paymentStatus": { "type": ["string", "number"], "description": "Generic form uses Pending/Paid; custom Add page writes 0 Unpaid, 1 Partially Paid, or 2 Paid." },
        "patientId": { "type": "string", "x-relationship": { "collection": "patient", "field": "id", "stores": "documentId" } },
        "requestDetailId": { "type": "string", "x-relationship": { "collection": "testRequest", "field": "id", "stores": "documentId" } },
        "patientVisitId": { "type": "string", "x-relationship": { "collection": "patientVisit", "field": "id", "stores": "documentId" } },
        "totalAmount": { "type": "number" },
        "name": { "type": "string", "description": "Custom Add page duplicates invoiceNo into name." },
        "patientName": { "type": "string" },
        "patientNo": { "type": "string" },
        "patientPhone": { "type": "string" },
        "corporateId": { "type": ["string", "null"], "x-relationship": { "collection": "corporate", "field": "id", "stores": "documentId" } },
        "referralDoctorId": { "type": ["string", "null"], "x-relationship": { "collection": "referralDoctor", "field": "id", "stores": "documentId" }, "description": "Null when Referral Type is Self or Corporate." },
        "referralType": { "type": "string", "enum": ["", "Self", "Corporate"] },
        "paymentType": { "type": "string", "enum": ["Cash", "Card", "UPI", "Net Banking", "Cheque", "Credit"] },
        "notes": { "type": "string" },
        "grossAmount": { "type": "number" },
        "discountType": { "type": "string", "enum": ["Fixed Amount", "Percentage"] },
        "discountValue": { "type": "number" },
        "discountAmount": { "type": "number" },
        "taxAmount": { "type": "number" },
        "netAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/saleInvoiceLine" } }
      },
      "required": ["invoiceNo", "invoiceDate", "patientId"]
    },
    "user": {
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "department": { "type": "string", "enum": ["Internal", "External"] },
        "disable": { "type": "boolean" },
        "address": { "type": "string" },
        "doctorDesignation": { "type": "string", "description": "Required by the form only when a role named Doctor is selected." },
        "doctorSignature": { "type": "string", "description": "PNG or JPG data URL, maximum 2 MB. Required by the form only when a role named Doctor is selected." },
        "photoUrl": { "type": "string" },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/userRole" } },
        "privileges": { "type": "array", "items": { "$ref": "#/$defs/privilege" }, "readOnly": true },
        "uid": { "type": "string" },
        "displayName": { "type": "string" }
      },
      "required": ["email", "firstName", "lastName", "department"]
    },
    "userRole": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "x-relationship": { "collection": "role", "field": "id", "stores": "documentId" } },
        "name": { "type": "string" },
        "privileges": { "type": "array", "items": { "$ref": "#/$defs/privilege" } }
      },
      "required": ["id", "name"]
    },
    "role": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "privileges": { "type": "array", "items": { "$ref": "#/$defs/privilege" } }
      },
      "required": ["name"]
    },
    "privilege": {
      "type": "object",
      "description": "Privilege map shape is managed by the user/role UI and can vary by module.",
      "properties": {
        "name": { "type": "string" },
        "module": { "type": "string" },
        "application": { "type": "string" },
        "read": { "type": "string" },
        "write": { "type": "string" }
      },
      "additionalProperties": true
    },
    "testRequest": {
      "type": "object",
      "properties": {
        "patientId": { "type": "string", "x-relationship": { "collection": "patient", "field": "id", "stores": "documentId" } },
        "sampleNo": { "type": "string" },
        "hisTestCode": { "type": "string" },
        "hisTestName": { "type": "string" },
        "specimenCode": { "type": "string" },
        "specimenName": { "type": "string" },
        "sampleCollectionDate": { "type": "string", "format": "date-time" },
        "sampleReceivedDate": { "type": "string", "format": "date-time" },
        "departmentId": { "type": "string", "x-relationship": { "collection": "department", "field": "id", "stores": "documentId" } },
        "referralDoctorId": { "type": "string", "x-relationship": { "collection": "referralDoctor", "field": "id", "stores": "documentId" } },
        "department": { "type": "string" },
        "hisRequestId": { "type": "string" },
        "hisRequestNo": { "type": "string" },
        "reportStatus": { "type": "string", "enum": ["Pending", "In Progress", "Completed", "Cancelled"] },
        "collectedBy": { "type": "string" },
        "receivedBy": { "type": "string" }
      },
      "required": ["patientId", "sampleNo"]
    },
    "testResultDetail": {
      "type": "object",
      "properties": {
        "testResultId": { "type": "string", "x-relationship": { "collection": "testResult", "field": "id", "stores": "documentId" } },
        "parameterCode": { "type": "string" },
        "parameterName": { "type": "string" },
        "result": { "type": "string" },
        "unit": { "type": "string" },
        "referenceRange": { "type": "string" },
        "status": { "type": "string", "enum": ["Normal", "Abnormal", "Critical"] }
      },
      "required": ["testResultId", "parameterName", "result"]
    },
    "controlResultDetail": {
      "type": "object",
      "properties": {
        "controlResultId": { "type": "string", "x-relationship": { "collection": "controlResult", "field": "id", "stores": "documentId" } },
        "parameterName": { "type": "string" },
        "result": { "type": "number" },
        "mean": { "type": "number" },
        "sd": { "type": "number" },
        "cv": { "type": "number" },
        "status": { "type": "string", "enum": ["In Control", "Out of Control"] }
      },
      "required": ["controlResultId", "parameterName"]
    },
    "lookupMaster": {
      "type": "object",
      "properties": {
        "lookupType": { "type": "string", "enum": ["Sample Type", "Test Category", "Test Group", "Method", "Unit", "Container", "Sample Rejection Reason", "Corporate", "Facility"] },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["lookupType", "name"]
    },
    "radiologyRequest": {
      "type": "object",
      "properties": {
        "patientId": { "type": "string", "x-relationship": { "collection": "patient", "field": "id", "stores": "documentId" } },
        "requestNo": { "type": "string" },
        "examType": { "type": "string" },
        "requestDateTime": { "type": "string", "format": "date-time" },
        "examDateTime": { "type": "string", "format": "date-time" },
        "comments": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Scheduled", "Completed", "Cancelled"] }
      },
      "required": ["patientId", "requestNo", "examType"]
    },
    "lisTest": {
      "type": "object",
      "properties": {
        "testCode": { "type": "string" },
        "name": { "type": "string" },
        "processingCategory": { "type": "string" },
        "description": { "type": "string" },
        "specimenId": { "type": "string", "x-relationship": { "collection": "specimen", "field": "id", "stores": "documentId" } },
        "departmentCode": { "type": "string", "x-relationship": { "collection": "department", "field": "departmentCode", "stores": "departmentCode" } },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["testCode", "name", "processingCategory"]
    },
    "hospital": {
      "type": "object",
      "properties": {
        "hospitalCode": { "type": "string" },
        "hospitalName": { "type": "string" },
        "corporateName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "isActive": { "type": "string", "enum": ["Yes", "No"] }
      },
      "required": ["hospitalCode", "hospitalName"]
    },
    "patientVisit": {
      "type": "object",
      "properties": {
        "patientId": { "type": "string", "x-relationship": { "collection": "patient", "field": "id", "stores": "documentId" } },
        "visitId": { "type": "string" },
