rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Temporary single-lab policy: any authenticated user can read and write
    // all documents. Replace with role- and collection-specific rules before
    // the app is used with untrusted or broader user groups.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}